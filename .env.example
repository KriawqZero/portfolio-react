# ir para o domínio público:
#
#   TURNSTILE_SECRET_KEY=        (server-side)
#   VITE_TURNSTILE_SITE_KEY=     (PÚBLICO — a única variável exposta)
#   UPSTASH_REDIS_REST_URL=      (server-side)
#   UPSTASH_REDIS_REST_TOKEN=    (server-side)
#   AI_RATE_LIMIT_REQUESTS=8
#   AI_RATE_LIMIT_WINDOW_SECONDS=600
#   AI_SESSION_DAILY_LIMIT=15
#   AI_IP_DAILY_LIMIT=30
#   AI_GLOBAL_DAILY_LIMIT=100
#   AI_GLOBAL_MONTHLY_LIMIT=1000
#
# Sem Redis não existe teto de gasto compartilhado, e é por isso que
# esta versão só deve viver em preview.
# ─────────────────────────────────────────────────────────────────
