# ─────────────────────────────────────────────────────────────────
# Marcilio IA — variáveis do endpoint /api/ask
#
# Copie para .env.local (que o .gitignore já cobre) e preencha.
# TUDO aqui é server-side, exceto o que estiver marcado como PÚBLICO.
# Nunca prefixe nada com VITE_ além do que já está marcado: o Vite
# embute qualquer VITE_* no bundle que vai para o navegador.
# ─────────────────────────────────────────────────────────────────

# Chave do projeto isolado da OpenAI criado só para o portfólio.
OPENAI_API_KEY=

# Modelo. sol = topo de linha, terra = equilíbrio, luna = mais barato e rápido.
OPENAI_MODEL=gpt-5.6-terra

# Esforço de raciocínio: none | low | medium | high.
# Acima de low a latência sobe muito e a resposta não melhora neste caso de uso.
AI_REASONING_EFFORT=low

# Liga a IA. Nasce desligada de propósito: a seção sobe antes de ser ativada.
AI_CHAT_ENABLED=false

# ── Limites por chamada ──────────────────────────────────────────
AI_MAX_MESSAGE_CHARACTERS=500
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_OUTPUT_TOKENS=350
AI_MAX_CONTEXT_CHARACTERS=6000
AI_MAX_DOCUMENTS=4
AI_MAX_BODY_BYTES=8192
AI_MAX_ANSWER_CHARACTERS=900
AI_REQUEST_TIMEOUT_MS=20000

# Sal do hash usado no identificador anônimo de sessão enviado à OpenAI.
# Gere com: openssl rand -hex 32
RATE_LIMIT_HASH_SECRET=

# ── Cloudflare Turnstile ─────────────────────────────────────────
# Em produção, sem estas duas o endpoint recusa toda pergunta.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=       # PÚBLICO — a única variável exposta ao navegador

# Só desenvolvimento: pula a verificação. Ignorada quando VERCEL_ENV=production.
AI_SKIP_TURNSTILE=false

# ── Upstash Redis ────────────────────────────────────────────────
# Base do rate limit e do teto de gasto. Em produção, sem estas duas o
# endpoint recusa toda pergunta: sem contador não há teto, e sem teto
# não se gasta.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Rate limit por visitante ─────────────────────────────────────
AI_RATE_LIMIT_REQUESTS=8
AI_RATE_LIMIT_WINDOW_SECONDS=600
AI_SESSION_DAILY_LIMIT=15
AI_IP_DAILY_LIMIT=30

# ── Cache de respostas ───────────────────────────────────────────
# Pergunta repetida sai do Redis, sem chamar a OpenAI e sem espera.
# Só respostas com status 'answered' são guardadas. A chave inclui a
# versão do dossiê, então mudar knowledge/ ou content.ts invalida tudo
# sozinho.
AI_ANSWER_CACHE=true
AI_ANSWER_CACHE_TTL_SECONDS=604800

# ── Teto global, somando todos os visitantes ─────────────────────
# É o que impede uma conta inesperada. O mensal segura o custo; o
# diário protege contra pico em um dia ruim.
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_MONTHLY_LIMIT=1000

# ─────────────────────────────────────────────────────────────────
# Lembrete que não é código: configure também um limite de gasto no
# projeto da OpenAI. É a única camada que continua valendo se tudo
# isto aqui falhar.
# ─────────────────────────────────────────────────────────────────
